# Local Windows control plane. No cloud account, model API key or rented service is required.
# Configure these in the backend process; this file is documentation, not an auto-loaded secret file.
REPOPILOT_ENV=local
REPOPILOT_MODE=owner
REPOPILOT_ORIGIN=http://127.0.0.1:3000
REPOPILOT_COOKIE_SECURE=false
REPOPILOT_OWNER_PASSWORD_HASH=
REPOPILOT_REPOSITORIES=naraya07pedro-spec/repopilot-ai
REPOPILOT_SOURCE_ROOTS={"naraya07pedro-spec/repopilot-ai":"fixtures/bug"}
REPOPILOT_MODEL_PROFILES_FILE=deploy/local-models.example.json
REPOPILOT_ALLOW_PAID_MODELS=false
REPOPILOT_DAILY_USD=0
REPOPILOT_RUN_USD=0
# Leave DATABASE_URL unset for local SQLite. Model/provider keys are unnecessary.
# No worker-enable setting exists. WSL2 availability alone cannot activate execution.
