# Inject with the private backend host's secret manager. Never deploy this literal file.
REPOPILOT_ENV=production
REPOPILOT_MODE=owner
REPOPILOT_ORIGIN=https://your-owner-host.example
REPOPILOT_COOKIE_SECURE=true
REPOPILOT_OWNER_PASSWORD_HASH=
REPOPILOT_DATABASE_SCHEMA=repopilot_private
DATABASE_URL=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
REPOPILOT_REPOSITORIES=naraya07pedro-spec/repopilot-ai
REPOPILOT_SOURCE_ROOTS={"naraya07pedro-spec/repopilot-ai":"fixtures/bug"}
REPOPILOT_MODEL_PROFILES_FILE=
REPOPILOT_ALLOW_PAID_MODELS=false
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
REPOPILOT_MODEL=
REPOPILOT_DAILY_USD=0
REPOPILOT_RUN_USD=0
REPOPILOT_INPUT_USD_PER_MILLION=0
REPOPILOT_OUTPUT_USD_PER_MILLION=0
# The private Next.js host only needs REPOPILOT_ORIGIN and REPOPILOT_BACKEND.
# No enable-execution variable exists: unvalidated worker execution remains closed.
