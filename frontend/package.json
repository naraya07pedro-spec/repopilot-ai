{
  "name": "repopilot-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "node scripts/prepare-public.mjs && tsc --noEmit",
    "test": "vitest run",
    "prepare:public": "node scripts/prepare-public.mjs",
    "pretest": "node scripts/prepare-public.mjs",
    "build:public": "node scripts/prepare-public.mjs && next build public-site",
    "prebuild": "node scripts/prepare-public.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26",
    "typescript": "^5.9",
    "vitest": "5.0.5"
  }
}
